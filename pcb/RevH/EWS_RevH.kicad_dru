(rule "Input spacing E2 HI_P3" (condition "(A.NetName == 'E2' && B.NetName == 'HI_P3') || (A.NetName == 'HI_P3' && B.NetName == 'E2')") (constraint clearance (min 3.0mm)))
(rule "Input spacing E2 HI_N1" (condition "(A.NetName == 'E2' && B.NetName == 'HI_N1') || (A.NetName == 'HI_N1' && B.NetName == 'E2')") (constraint clearance (min 7.0mm)))
(rule "Input spacing E2 HI_N2" (condition "(A.NetName == 'E2' && B.NetName == 'HI_N2') || (A.NetName == 'HI_N2' && B.NetName == 'E2')") (constraint clearance (min 6.0mm)))
