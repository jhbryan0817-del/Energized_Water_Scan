(rule "Input spacing LO_N1 LO_N3" (condition "(A.NetName == 'LO_N1' && B.NetName == 'LO_N3') || (A.NetName == 'LO_N3' && B.NetName == 'LO_N1')") (constraint clearance (min 2.0mm)))
(rule "Input spacing LO_N2 LO_N3" (condition "(A.NetName == 'LO_N2' && B.NetName == 'LO_N3') || (A.NetName == 'LO_N3' && B.NetName == 'LO_N2')") (constraint clearance (min 1.0mm)))
