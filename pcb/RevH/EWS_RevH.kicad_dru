(version 1)
(rule "HV to logic isolation - engineering minimum"
 (condition "A.NetName != '' && B.NetName != '' && ((A.NetClass == 'HV' && B.NetClass != 'HV') || (B.NetClass == 'HV' && A.NetClass != 'HV'))")
 (constraint clearance (min 8mm)))

# Functional spacing targets inside floating input domain
(rule "Input spacing E2 E4" (condition "(A.NetName == 'E2' && B.NetName == 'E4') || (A.NetName == 'E4' && B.NetName == 'E2')") (constraint clearance (min 8.0mm)))
(rule "Input spacing E2 HV_REF" (condition "(A.NetName == 'E2' && B.NetName == 'HV_REF') || (A.NetName == 'HV_REF' && B.NetName == 'E2')") (constraint clearance (min 4.0mm)))
(rule "Input spacing E2 HI_DCDC" (condition "(A.NetName == 'E2' && B.NetName == 'HI_DCDC') || (A.NetName == 'HI_DCDC' && B.NetName == 'E2')") (constraint clearance (min 4.0mm)))
(rule "Input spacing E2 HI_HLDO" (condition "(A.NetName == 'E2' && B.NetName == 'HI_HLDO') || (A.NetName == 'HI_HLDO' && B.NetName == 'E2')") (constraint clearance (min 4.0mm)))
(rule "Input spacing E2 HI_INP" (condition "(A.NetName == 'E2' && B.NetName == 'HI_INP') || (A.NetName == 'HI_INP' && B.NetName == 'E2')") (constraint clearance (min 4.0mm)))
