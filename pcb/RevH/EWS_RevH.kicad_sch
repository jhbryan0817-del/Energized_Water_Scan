(kicad_sch (version 20250114) (generator "eeschema") (uuid c1e8c922-faa2-5920-8a56-5962dea42720) (paper "A3")
    (title_block (title "EWS Rev H / System overview") (rev "H prototype") (company "IoT Beyond Lab") (comment 1 "Engineering prototype - qualification required"))
(lib_symbols)
(text "Two electrodes E2/E4 -> four-resistor-per-leg input networks -> dual AMC3330 isolated paths -> independent ADS1115 converters -> ESP32." (at 20 20 0) (effects (font (size 1.1 1.1)) (justify left)))
(text "HI: 997:1 divider; 600 VAC RMS design target. LO: 10.96:1 divider; use conservative +/-2 V working range before characterization." (at 20 27 0) (effects (font (size 1.1 1.1)) (justify left)))
(text "Both ADCs sample continuously at 860 SPS nominal; separate unsynchronized clocks. DIAG and READY are wired to ESP32." (at 20 34 0) (effects (font (size 1.1 1.1)) (justify left)))
(text "2S harness -> F1 -> Q1 -> protected VBAT. Motor/ESC power stays external. Never parallel ESC BEC." (at 20 41 0) (effects (font (size 1.1 1.1)) (justify left)))
(text "Remove JP1 before USB. U1 requires WROOM pin availability. Expansion signals are 3.3 V only." (at 20 48 0) (effects (font (size 1.1 1.1)) (justify left)))
(text "No CAT rating, surge qualification, water-safety threshold or guaranteed detection floor is claimed." (at 20 55 0) (effects (font (size 1.1 1.1)) (justify left)))
