(kicad_sch (version 20250114) (generator "eeschema") (uuid c0cc0f22-f688-532e-bb7d-c3e90bbfdc2c) (paper "A3")
    (title_block (title "EWS Rev G / System overview") (rev "G - engineering prototype") (company "IoT Beyond Lab") (comment 1 "Not qualified for energized-water use; see design and validation record"))
(lib_symbols)
(text "Two electrodes E2/E4 -> four-resistor-per-leg input networks -> dual AMC3330 isolated paths -> ADS1115 -> ESP32." (at 20 20 0) (effects (font (size 1.1 1.1)) (justify left)))
(text "HI: 997:1 divider; 600 VAC RMS design target. LO: 10.96:1 divider; use conservative +/-2 V working range before characterization." (at 20 27 0) (effects (font (size 1.1 1.1)) (justify left)))
(text "Both ranges continuously connected. Sensitive path clamps during a fault; test leakage, gain error, saturation and recovery." (at 20 34 0) (effects (font (size 1.1 1.1)) (justify left)))
(text "External fused 2S harness feeds PCB logic/servos; motor/ESC high-current power stays off PCB. Never parallel ESC BEC." (at 20 41 0) (effects (font (size 1.1 1.1)) (justify left)))
(text "Remove JP1 before USB. U1 requires WROOM pin availability. Expansion signals are 3.3 V only." (at 20 48 0) (effects (font (size 1.1 1.1)) (justify left)))
(text "No CAT rating, surge qualification, water-safety threshold or guaranteed detection floor is claimed." (at 20 55 0) (effects (font (size 1.1 1.1)) (justify left)))
